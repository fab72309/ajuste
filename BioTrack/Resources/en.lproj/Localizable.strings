"legal.privacy.title" = "Privacy";
"legal.privacy.summary.1" = "AJUSTE stores your tracking data locally on your device. No user account is required and AJUSTE does not send your data to a dedicated server.";
"legal.privacy.summary.2" = "If you enable Health access, only the categories you authorize are read to prefill selected metrics inside the app.";
"legal.privacy.summary.3" = "AJUSTE does not sell your data. Exports are manual, initiated by you, and saved to the location you choose.";
